{
  "name": "matchday-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build-all.mjs",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:sites": "node scripts/run-framework.mjs dev",
    "build:sites": "node scripts/run-framework.mjs build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts tests/selection.test.ts",
    "test:postgres": "node --conditions=react-server --import tsx --test tests/postgres-accounts.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-db.mjs",
    "test:accounts": "node --conditions=react-server --import tsx --test tests/account-key.test.ts",
    "build:next": "next build",
    "test:adapters": "node --conditions=react-server --import tsx --test tests/adapters.test.ts",
    "test:http": "node --import tsx --test tests/http-smoke.test.ts",
    "format": "prettier --write app components hooks lib tests proxy.ts next.config.ts README.md docs",
    "test:fixtures": "node --conditions=react-server --import tsx --test tests/fixtures.test.ts",
    "test:creative": "node --conditions=react-server --import tsx --test tests/creative.test.ts",
    "test:gallery": "tsx --test tests/local-gallery.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/blob": "^2.8.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.6",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
