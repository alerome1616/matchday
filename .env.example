# true = local gallery and no Supabase login. Images are NEVER simulated.
# In local mode, enter a temporary OpenAI key in the app (not persisted).
NEXT_PUBLIC_DEMO_MODE=true

# Recommended for Vercel: own PostgreSQL accounts (no Supabase Auth).
# Set AUTH_PROVIDER=postgres AND DATABASE_URL to activate. No secret is public.
AUTH_PROVIDER=
DATABASE_URL=
# Private Vercel Blob store, for gallery files in PostgreSQL mode.
BLOB_READ_WRITE_TOKEN=
# Own-backend generation requests per user/day (UTC), independent of selection count.
DAILY_GENERATION_LIMIT=100

# Required for Supabase gallery and auth (NEXT_PUBLIC_DEMO_MODE=false).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Supabase secret key (sb_secret_...) or legacy service_role key.
# Only needed to store encrypted per-user OpenAI credentials.
SUPABASE_SECRET_KEY=
# Exactly 64 hexadecimal characters (32 random bytes). Keep and back up privately.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=
# Public HTTPS origin for Linux reverse proxy and email confirmation redirects.
# Example: https://matchday.instituto.example (no trailing path).
APP_URL=

# espn (default, no key) | api-football | mock (explicit fixture tests only).
FOOTBALL_PROVIDER=espn
FOOTBALL_API_KEY=

# Real server generation. A temporary caller key is also supported.
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
